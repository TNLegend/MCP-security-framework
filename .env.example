PROJECT_NAME=mcp-security-framework
ENVIRONMENT=local

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
CONTROL_CENTER_PUBLIC_URL=
UPSTREAM_OAUTH_CALLBACK_URL=
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
MCP_SECURITY_API_BASE_URL=http://127.0.0.1:8000/api/v1

MCP_GATEWAY_HOST=127.0.0.1
MCP_GATEWAY_PORT=9001
MCP_LAB_PORT=9000
LOCAL_RUNTIME_START_TIMEOUT_SECONDS=20
LOCAL_RUNTIME_AUTOSTART_OPA=true
LOCAL_RUNTIME_AUTOSTART_GATEWAY=true
LOCAL_RUNTIME_AUTOSTART_IDENTITY_PROVIDER=true
LOCAL_RUNTIME_MANAGED_POSTGRES_COMMAND_JSON=
LOCAL_RUNTIME_RESTART_ATTEMPTS=2
LOCAL_RUNTIME_RESTART_BACKOFF_SECONDS=1
LOCAL_RUNTIME_LOG_MAX_BYTES=5000000
LOCAL_RUNTIME_LOG_BACKUP_COUNT=3

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_DB=mcp_security
POSTGRES_USER=mcp_user
POSTGRES_PASSWORD=<generate-local>
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=1800

RUNTIME_LOG_RETENTION_DAYS=30
RUNTIME_LOG_MAX_ROWS=250000
RUNTIME_LOG_CLEANUP_BATCH_SIZE=5000
RUNTIME_LOG_AUTO_CLEANUP_INTERVAL_ROWS=1000
OPERATIONS_METRICS_WINDOW_MINUTES=15

# Build Security local-source intake is fail-closed to configured roots.
# Relative roots are resolved against the cloned repository.
# Empty list = the ADMIN native folder picker may select any available local drive/root.
# Set explicit paths here only if you want to restrict accepted local Build source folders.
BUILD_SCAN_ALLOWED_ROOTS_JSON=[]
BUILD_SCAN_GIT_ALLOWED_HOSTS_JSON=["github.com","gitlab.com","bitbucket.org"]
BUILD_SCAN_GIT_TIMEOUT_SECONDS=300
BUILD_SCAN_GIT_MAX_OUTPUT_BYTES=1000000
BUILD_SCAN_MAX_FILES=20000
BUILD_SCAN_MAX_TOTAL_BYTES=1000000000
BUILD_SCAN_MAX_FILE_BYTES=100000000
BUILD_SCAN_TRIVY_DB_MAX_AGE_HOURS=72

LLM_PROVIDER=mock
SECURITY_PACK_AI_PROVIDER=gemini
SECURITY_PACK_AI_FALLBACK_PROVIDER=groq
CONTROLLED_AI_PROVIDER=gemini
CONTROLLED_AI_FALLBACK_PROVIDER=groq
LLM_FALLBACK_PROVIDER=
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=20

GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=

DEFAULT_POLICY_MODE=block
ENABLE_RUNTIME_LOGGING=true

OPA_BASE_URL=http://127.0.0.1:8181
OPA_DECISION_PATH=/v1/data/mcp/security/runtime/decision
OPA_TIMEOUT_SECONDS=2

AGENT_IDENTITY_PROVIDER=jwt_jwks
AGENT_IDENTITY_ISSUER=http://127.0.0.1:9100/
AGENT_IDENTITY_AUDIENCE=mcp-security-proxy
AGENT_IDENTITY_JWKS_URL=http://127.0.0.1:9100/jwks.json
AGENT_IDENTITY_SIGNING_PRIVATE_KEY_PATH=.runtime/secrets/local-idp-private.pem
AGENT_IDENTITY_PUBLIC_JWKS_PATH=.runtime/secrets/local-idp-public-jwks.json
AGENT_IDENTITY_KEY_ID=local-idp-rs256-1
AGENT_IDENTITY_ALLOWED_ALGORITHMS=RS256
AGENT_IDENTITY_ACCEPTED_TYPES=at+jwt
AGENT_IDENTITY_CLOCK_SKEW_SECONDS=30
AGENT_IDENTITY_HTTP_TIMEOUT_SECONDS=2
AGENT_IDENTITY_JWKS_CACHE_TTL_SECONDS=300
AGENT_IDENTITY_TOKEN_MAX_SIZE_BYTES=16384
AGENT_IDENTITY_BINDINGS_PATH=policies/identity_bindings.yaml

TRUSTED_SESSION_ENABLED=true
TRUSTED_SESSION_TTL_SECONDS=3600
TRUSTED_SESSION_IDLE_TIMEOUT_SECONDS=900
TRUSTED_SESSION_TOKEN_BYTES=32
TRUSTED_SESSION_TOKEN_PEPPER=<configure-secret-pepper>
TRUSTED_SESSION_MAX_ACTIVE_PER_AGENT=20
TRUSTED_SESSION_CLEANUP_BATCH_SIZE=100

PROXY_ASSERTION_ISSUER=mcp-security-proxy
PROXY_ASSERTION_AUDIENCE=mcp-security-backend
PROXY_ASSERTION_PRIVATE_KEY_PATH=.runtime/secrets/proxy-assertion-private.pem
PROXY_ASSERTION_KEY_ID=proxy-assertion-local
PROXY_ASSERTION_TTL_SECONDS=30

BACKEND_ASSERTION_JWKS_PATH=.runtime/secrets/proxy-assertion-public-jwks.json
BACKEND_ASSERTION_EXPECTED_ISSUER=mcp-security-proxy
BACKEND_ASSERTION_EXPECTED_AUDIENCE=mcp-security-backend
BACKEND_ASSERTION_MAX_TTL_SECONDS=30
BACKEND_ASSERTION_CLOCK_SKEW_SECONDS=5

INTERNAL_SERVICE_PUBLIC_KEYS_PATH=.runtime/secrets/internal-service-public-keys.json
INTERNAL_SERVICE_TIMESTAMP_WINDOW_SECONDS=60
MCP_PROXY_SERVICE_ID=MCP_PROXY
MCP_PROXY_SERVICE_KEY_ID=mcp-proxy-local
MCP_PROXY_SERVICE_PRIVATE_KEY_PATH=.runtime/secrets/mcp-proxy-service-ed25519.pem
MCP_DISCOVERY_SERVICE_ID=MCP_DISCOVERY
MCP_DISCOVERY_SERVICE_KEY_ID=mcp-discovery-local
MCP_GATEWAY_ALLOWED_ORIGINS=http://127.0.0.1:9001,http://localhost:9001
MCP_PROTOCOL_REDISCOVERY_INTERVAL_SECONDS=900
MCP_DISCOVERY_SERVICE_PRIVATE_KEY_PATH=.runtime/secrets/mcp-discovery-service-ed25519.pem

# Optional M3 Prompt Guard V3 research-only shadow.
# Leave disabled for normal analysis. Lot B2 uses a single daemon worker
# with a bounded process-local queue, not a production-grade isolated service.
# Lot B must still qualify execution and hard timeout/crash isolation before
# any production activation. The source-bound report is PENDING until lookup.
# Lot B must first qualify latency and
# source-balanced negatives. No neural score can authorize or block an MCP call.
M3_PG2_V3_SHADOW_ENABLED=false
# Optional local directory of previously verified V3 files for setup:
M3_PG2_V3_SOURCE_DIR=
# Optional immutable Hugging Face commit for research installation. The
# local V3 checkpoint must first be privately uploaded and its commit
# SHA verified; no branch HEAD or public fallback is accepted.
M3_PG2_V3_HF_REVISION=

# Reviewed code adapters are verified before import and become active only after a
# controlled backend/Gateway restart. Leave both values empty when none are installed.
TRUSTED_ADAPTER_DIRECTORY=
TRUSTED_ADAPTER_SIGNER_FINGERPRINTS=

AWS_REGION=eu-west-3
AWS_PROFILE=default
