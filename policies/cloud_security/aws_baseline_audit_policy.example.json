{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DescribeEC2ReadOnly",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeSecurityGroups"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EnumerateBucketsReadOnly",
      "Effect": "Allow",
      "Action": [
        "s3:ListAllMyBuckets"
      ],
      "Resource": "*"
    },
    {
      "Sid": "InspectOneBucketPublicAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketPublicAccessBlock"
      ],
      "Resource": "arn:aws:s3:::YOUR_PRIVATE_AUDIT_BUCKET"
    },
    {
      "Sid": "ListIamRolesReadOnly",
      "Effect": "Allow",
      "Action": [
        "iam:ListRoles"
      ],
      "Resource": "*"
    }
  ]
}
