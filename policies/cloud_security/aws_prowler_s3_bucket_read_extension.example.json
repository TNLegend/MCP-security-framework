{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ProwlerReviewedS3BucketReadOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:GetBucketPolicyStatus",
        "s3:GetEncryptionConfiguration",
        "s3:GetBucketVersioning",
        "s3:GetBucketLogging"
      ],
      "Resource": "arn:aws:s3:::REPLACE_WITH_REVIEWED_BUCKET_NAME"
    }
  ]
}
